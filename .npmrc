# React Native / Expo's Metro bundler expects a flat, hoisted node_modules tree
# (the way npm/yarn classic lay it out). pnpm's default "isolated" linker uses
# symlinks that Metro cannot resolve reliably, so we opt into pnpm's hoisted
# mode for this workspace - this is Expo's own documented recommendation for pnpm.
node-linker=hoisted
public-hoist-pattern[]=*
confirmModulesPurge=false
