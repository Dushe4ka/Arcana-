# Copy this file to .env and fill in real values for local development.

# PostgreSQL connection string (asyncpg driver - used by both the app and Alembic migrations).
DATABASE_URL="postgresql+asyncpg://arcana:arcana_dev_password@localhost:5432/arcana_dev"

# Random secrets used to sign JWTs. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

PORT=4000
ENVIRONMENT="development"

# Local static-file uploads root (swap for S3/R2 in production).
UPLOADS_DIR="./uploads"
