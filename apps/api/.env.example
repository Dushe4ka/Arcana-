# Copy this file to .env and fill in real values for local development.

# PostgreSQL connection string (asyncpg driver - used by both the app and Alembic migrations).
DATABASE_URL="postgresql+asyncpg://arcana:arcana_dev_password@localhost:5432/arcana_dev"

# Random secrets used to sign JWTs. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

PORT=4000
ENVIRONMENT="development"

# Local static-file uploads root (swap for S3/R2 in production).
UPLOADS_DIR="./uploads"

# Base URL used to build absolute URLs for uploaded files (e.g. "{PUBLIC_BASE_URL}/uploads/x.png").
# This value gets baked into the URL the moment an author uploads a file - it's stored inside
# story content (scene node data), not resolved at read time. Getting it wrong doesn't
# self-correct by changing this setting later; already-uploaded files keep the old URL until
# re-uploaded or manually migrated. Set it to the real public origin the API is served from.
PUBLIC_BASE_URL="http://localhost:4000"

# YooKassa merchant credentials for HARD-currency purchases from the player cabinet site.
# Leave blank in local dev unless you have sandbox credentials - purchases will fail cleanly
# with a YooKassa 401 rather than crash the app. See https://yookassa.ru/developers/api
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Base URL of the player cabinet site (a separate app from this API and from apps/admin).
CABINET_BASE_URL="http://localhost:3100"
