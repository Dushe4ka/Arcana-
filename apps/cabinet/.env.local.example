# Backend API base URL, including /api. Server-only (the browser never calls the backend
# directly). Defaults to http://localhost:4000/api if unset.
API_BASE_URL="http://localhost:4000/api"

# Controls the Secure flag on session cookies. In production it defaults ON — set "false"
# only to override (e.g. a temporary non-HTTPS staging box). Local dev ignores this value
# entirely and never sets Secure (http://localhost).
COOKIE_SECURE="false"
