# Backend API base URL (including /api). Defaults to http://localhost:4000/api if unset.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Note: uploaded-image preview URLs are absolute, built from the BACKEND's own
# PUBLIC_BASE_URL setting (apps/api/.env.example) - if the backend runs on a different
# host/port than what it's configured with there, uploaded image previews will 404.
